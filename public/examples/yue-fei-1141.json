      "accessed": "2026-11-21",
      "origin": "web"
    },
    {
      "id": "biography",
      "title": "《宋史》卷三百六十五 · 岳飞传",
      "url": "https://zh.wikisource.org/wiki/宋史/卷365",
      "accessed": "2026-11-21",
      "origin": "web"
    }
  ],
  "claims": [
    {
      "id": "dismissal",
      "text": "绍兴十一年八月，宋高宗罢岳飞。",
      "status": "supported",
      "scope": "context",
      "citations": [
        {
          "source": "annals",
          "locator": "绍兴十一年八月",
          "quote": "甲戌，罷岳飛。乙亥"
        }
      ]
    },
    {
      "id": "office",
      "text": "同年春夏，岳飞曾任枢密副使，秦桧进尚书左仆射并兼枢密使。",
      "status": "supported",
      "scope": "context",
      "citations": [
        {
          "source": "annals",
          "locator": "绍兴十一年四月",
          "quote": "俊並爲樞密使，飛樞密副使"
        },
        {
          "source": "annals",
          "locator": "绍兴十一年六月",
          "quote": "加秦檜特進，進尚書左僕射"
        }
      ]
    },
    {
      "id": "treaty",
      "text": "当年十一月，宋与金达成和议。",
      "status": "supported",
      "scope": "observed",
      "citations": [
        {
          "source": "annals",
          "locator": "绍兴十一年十一月",
          "quote": "是月，與金國和議成，立盟書"
        }
      ]
    },
    {
      "id": "yue-position",
      "text": "据《宋史·岳飞传》，岳飞对议和安排表达过异议。",
      "status": "supported",
      "scope": "context",
      "citations": [
        {
          "source": "biography",
          "locator": "绍兴九年",
          "quote": "飛表謝，寓和議不便之意"
        }
      ]
    },
    {
      "id": "drought",
      "text": "本纪记有当年秋七月的旱情与朝廷应对。",
      "status": "supported",
      "scope": "context",
      "citations": [
        {
          "source": "annals",
          "locator": "绍兴十一年七月",
          "quote": "以旱，減膳祈禱，遣官"
        }
      ]
    },
    {
      "id": "intervention",
      "text": "用持续的议政授权表示信任提升。皇帝仍须协调朝廷，并且双方仍需同意才能改变和议条款。",
      "status": "assumption",
      "scope": "context",
      "citations": []
    },
    {
      "id": "preferences",
      "text": "岳飞在获授权时会尝试提出调整。秦桧在模型中仍倾向维持原议程，只有朝廷能协调时才送出新议程。选项效用是表示先后顺序的模型假设。",
      "status": "assumption",
      "scope": "context",
      "citations": []
    },
    {
      "id": "jin-reaction",
      "text": "金方对改议的开放程度未知。分别推演愿意重议和维持条件。接受重议只表示谈判重新开始。",
      "status": "assumption",
      "scope": "context",
      "citations": []
    },
    {
      "id": "weather-gap",
      "text": "现有旱情记载不足以量化其对财力或谈判立场的影响。演示保留这一缺口。",
      "status": "assumption",
      "scope": "context",
      "citations": []
    }
  ],
