  "claims": [
    {
      "id": "debate",
      "text": "《明史》记载廷臣请求太子赴南京，崇祯未接受。",
      "status": "supported",
      "scope": "context",
      "citations": [
        {
          "source": "annals",
          "locator": "崇祯十七年三月",
          "quote": "李邦華等復請太子撫軍南京，不聽"
        }
      ]
    },
    {
      "id": "response",
      "text": "模型假定南京机构须先收到可执行的授权，再由地方力量决定是否承认。授权与承认均是显式假设。",
      "status": "assumption",
      "scope": "context",
      "citations": []
    },
    {
      "id": "real-nanjing",
      "text": "北京中枢失效后，福王在南京监国是另一条继统路径。",
      "status": "supported",
      "scope": "observed",
      "citations": [
        {
          "source": "hongguang",
          "locator": "崇祯十七年五月",
          "quote": "福王建監國於南京"
        }
      ]
    }
  ],
  "timeline": [
